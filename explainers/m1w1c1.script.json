     "show": {
      "kind": "table",
      "row": 0,
      "keep": true
     }
    },
    {
     "say": "He, she, it, is.",
     "show": {
      "kind": "table",
      "row": 1,
      "keep": true
     }
    },
    {
     "say": "You, we, they, are.",
