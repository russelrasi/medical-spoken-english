   "heading": "Rule 1: Subject + Verb + Object",
   "lines": [
    {
     "say": "Rule one. English sentences follow this order: subject, verb, object.",
     "show": {
      "kind": "svo",
      "reveal": 3,
      "labels": true
     }
    },
    {
     "say": "The verb sits in the middle, right after the subject. For example: I am a medical student.",
     "show": {
