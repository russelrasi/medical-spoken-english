   "type": "rule",
   "heading": "Rule 1: Subject + Verb + Object",
   "from": 208,
   "frames": 496,
   "lines": [
    {
     "say": "Rule one. English sentences follow this order: subject, verb, object.",
     "audio": "m1w1c1/l001.mp3",
     "from": 0,
     "frames": 238,
     "lead": 12,
     "show": {
      "kind": "svo",
      "reveal": 3,
      "labels": true
     }
    },
    {
     "say": "The verb sits in the middle, right after the subject. For example: I am a medical student.",
     "audio": "m1w1c1/l002.mp3",
     "from": 238,
     "frames": 258,
     "lead": 12,
     "show": {
      "kind": "example",
      "ref": [
       0,
       1
      ],
      "focus": [
       {
        "w": "I",
        "role": "subj"
       },
       {
        "w": "am",
        "role": "verb"
       }
      ],
      "text": "I am a medical student.",
      "bn": "আমি একজন মেডিকেল শিক্ষার্থী।"
     }
    }
   ]
  },
  {
   "type": "rule",
   "heading": "Rule 2: Choose am, is or are",
   "from": 704,
   "frames": 730,
   "lines": [
    {
     "say": "Rule two. Match am, is or are to the subject.",
