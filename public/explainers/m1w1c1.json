     "from": 177,
     "frames": 87,
     "lead": 12,
     "show": {
      "kind": "table",
      "row": 0,
      "keep": true
     }
    },
    {
     "say": "He, she, it, is.",
     "audio": "m1w1c1/l005.mp3",
     "from": 264,
     "frames": 115,
     "lead": 12,
     "show": {
      "kind": "table",
      "row": 1,
      "keep": true
     }
    },
    {
     "say": "You, we, they, are.",
     "audio": "m1w1c1/l006.mp3",
     "from": 379,
     "frames": 132,
     "lead": 12,
     "show": {
      "kind": "table",
      "row": 2,
      "keep": true
     }
    },
    {
     "say": "Careful. He is for a male. She is for a female.",
